{
	"name": "postpigeon",
	"version": "1.0.0",
	"description": "A lightweight automation tool for posting developer-focused content to X (Twitter). Supports scheduled posts, media uploads, and random posting intervals.",
	"type": "module",
	"main": "service/index.js",
	"scripts": {
		"start": "next start",
		"dev": "next dev",
		"dev:local": "next dev",
		"dev:legacy": "concurrently -k -n BE,FE -c cyan,magenta \"npm run dev:be\" \"npm run dev:fe\"",
		"dev:be": "node --watch service/index.js",
		"dev:fe": "npm --prefix dashboard run dev",
		"files:doctor": "node service/cli/files-doctor.js",
		"build": "next build",
		"build:dashboard": "npm --prefix dashboard install && npm --prefix dashboard run build",
		"test": "jest --detectOpenHandles --runInBand --passWithNoTests",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [
		"twitter",
		"x-api",
		"automation",
		"post-scheduler",
		"tweet-bot",
		"developer-tools",
		"cron",
		"social-automation",
		"oauth1"
	],
	"author": "Devendra Pratap <dps.manit@gmail.com>",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/0xdps/postpigeon/issues"
	},
	"homepage": "https://github.com/0xdps/postpigeon#readme",
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.9",
		"@mesahub/client": "^1.0.2",
		"dotenv": "^16.4.5",
		"hono": "^4.12.3",
		"jose": "^6.1.3",
		"next": "^15.5.28",
		"node-cron": "^4.2.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"twitter-api-v2": "^1.15.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"concurrently": "^9.2.1",
		"eslint": "^9.39.1",
		"jest": "^29.7.0",
		"prettier": "^3.6.2",
		"rust-just": "^1.40.0"
	}
}

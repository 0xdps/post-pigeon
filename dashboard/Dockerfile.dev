# Development stage with Vite dev server for hot reload
FROM node:22-alpine AS dev

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source (will be mounted via volumes in compose)
COPY . .

EXPOSE 5173

# Run Vite dev server with host set to 0.0.0.0 to allow external access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

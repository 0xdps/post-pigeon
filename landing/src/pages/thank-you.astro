---
import Base from "../layouts/Base.astro";
---

<Base
  title="You're on the list"
  description="Thanks for joining the PostPigeon waitlist. We'll be in touch."
>
  <div class="thankyou-wrap">
    <div class="thankyou-card">
      <div class="pigeon-symbol">
        <img src="/logo-128.png" width="96" height="96" alt="PostPigeon" />
      </div>
      <span class="chip">Confirmed</span>
      <h1>You're on the list.</h1>
      <p>
        Thanks for your interest in PostPigeon. We'll send you a single email when
        early access opens — no newsletters, no noise.
      </p>
      <a href="/" class="btn-back">Back to home</a>
    </div>
  </div>
</Base>

<style>
  .thankyou-wrap {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .thankyou-card {
    max-width: 480px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    padding: 3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper-warm);
  }

  .pigeon-symbol {
    margin-bottom: 0.5rem;
    animation: pigeonBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes pigeonBounce {
    from { opacity: 0; transform: scale(0.5) translateY(10px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  .thankyou-card h1 {
    font-family: var(--serif);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .thankyou-card p {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.8;
    max-width: 360px;
  }

  .btn-back {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    border: 1px solid var(--accent);
    padding: 0.5rem 1.2rem;
    border-radius: var(--radius);
    transition: background 0.2s, color 0.2s;
  }

  .btn-back:hover {
    background: var(--accent);
    color: var(--paper);
  }
</style>

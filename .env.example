# ── X / Twitter ───────────────────────────────────────────────────────────────
# Create an app at https://developer.twitter.com → Keys and Tokens
# App permissions must be set to "Read and Write"
TWITTER_API_KEY=
TWITTER_API_KEY_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── LinkedIn ───────────────────────────────────────────────────────────────────
# Create an app at https://linkedin.com/developers → add "Share on LinkedIn" product
# Access token must have scopes: openid, profile, w_member_social
# See docs/platforms/linkedin.md for the full OAuth flow
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=          # urn:li:person:XXXXXX — from GET /v2/userinfo

# ── Threads (Meta) ────────────────────────────────────────────────────────────
# Create a Meta app at https://developers.facebook.com → add "Threads API" product
# Access token must have scopes: threads_basic, threads_content_publish
# See docs/platforms/threads.md for the full OAuth flow
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=              # numeric user ID — from GET /v1.0/me

# ── Dev.to ────────────────────────────────────────────────────────────────────
# Generate an API key at https://dev.to/settings/extensions → DEV API Keys
DEVTO_API_KEY=

# ── Reddit ────────────────────────────────────────────────────────────────────
# Reddit has disabled self-serve API access for new developers (late 2024).
# Manual approval is required and rarely granted. Leaving these here for future use.
# See docs/platforms/reddit.md for details.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_USER_AGENT=          # e.g. script:PostPigeon:v1.0 (by /u/yourusername)

# ── SQLite Hub ────────────────────────────────────────────────────────────────
# See https://github.com/your-org/sqlite-hub for setup
SQLITE_HUB_URL=               # e.g. https://your-sqlite-hub.up.railway.app
SQLITE_HUB_SERVICE_SECRET=    # service_secret from sqlite-hub admin Settings
SQLITE_HUB_DB=postpigeon

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=                  # your admin password for the dashboard
SESSION_SECRET=               # random secret for signing JWT session cookies (min 32 chars)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_ENABLED=true
CRON_SCHEDULE=0 0 9-20 * * *  # 6-field node-cron: sec min hr day month weekday

# ── Optional — all can also be changed live via the dashboard Settings page ───
TIMEZONE=Asia/Kolkata          # IANA timezone for posting-hours enforcement
DAILY_LIMIT=10                 # Max posts per day
POST_PROBABILITY=1             # Probability (0–1) of posting on each cron tick
COOLDOWN_MINUTES=120           # Minimum minutes between posts
RANDOM_DELAY_MINUTES=60        # Add 0–N minutes of random delay on each cron fire
POST_MAX_RETRIES=3             # Retry attempts for failed posts
MAX_TWEET_LENGTH=1000          # Character limit applied before sending to X
DRY_RUN=false                  # true = log actions without actually posting
